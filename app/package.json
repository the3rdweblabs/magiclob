{
  "name": "magicbook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "indexer": "node --import tsx scripts/indexer.ts",
    "setup:market": "node --import tsx scripts/setup-demo-market.ts",
    "seed:history": "node --import tsx scripts/seed-history.ts",
    "dev:full": "concurrently -n app,indexer -c cyan,magenta \"npm run dev\" \"npm run indexer\""
  },
  "dependencies": {
    "@magiclob/sdk": "file:../sdk",
    "@solana/wallet-adapter-backpack": "^0.1.14",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "@tailwindcss/postcss": "^4.3.3",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.44.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript-linux-x64": "^7.0.2",
    "concurrently": "^10.0.5",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bigint-buffer@1.1.5": true
  }
}
