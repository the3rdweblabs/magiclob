# MagicBook - network-keyed environment matrix.
#
# Every network-dependent variable follows the form `VAR_NAME_{NETWORK}` where
# {NETWORK} is one of LOCAL / DEVNET / MAINNET. All values shown are the built-in
# defaults; override any of them by uncommenting the line here.
#
# The same file drives the Next.js app (via /api/config) and every CLI script
# (setup-demo-market, seed-history, indexer - they accept SOLANA_NETWORK too).

# Active network: local | devnet | mainnet
SOLANA_NETWORK=local

# RPC / WS (MagicBlock public RPC is the default - keyless, no API token, and
# carries automatic failover to their regional endpoints + the public pool,
# see RPC_FAILOVERS in the SDK. Only point these at api.devnet.solana.com if
# you have your own quota.)
RPC_URL_LOCAL=http://127.0.0.1:8899
WS_URL_LOCAL=ws://127.0.0.1:8900
# RPC_URL_DEVNET=https://rpc.magicblock.app/devnet
# WS_URL_DEVNET=wss://rpc.magicblock.app/devnet
# RPC_URL_MAINNET=https://rpc.magicblock.app/mainnet
# WS_URL_MAINNET=wss://rpc.magicblock.app/mainnet

# Program (same id everywhere by default)
PROGRAM_ID_LOCAL=DSMktdhdDAGgittEg88wqrh2AJmNq6oj2YDnNnmeKeQe
PROGRAM_ID_DEVNET=DSMktdhdDAGgittEg88wqrh2AJmNq6oj2YDnNnmeKeQe
PROGRAM_ID_MAINNET=DSMktdhdDAGgittEg88wqrh2AJmNq6oj2YDnNnmeKeQe

# Magicblock Ephemeral Rollup router (devnet/mainnet only)
# ROUTER_URL_DEVNET=https://devnet-router.magicblock.app
# ROUTER_URL_MAINNET=https://router.magicblock.app

# Markets per network: JSON map of symbol -> market pubkey
# MARKETS_LOCAL={"SOL/USDC":"DSMktdhdDAGgittEg88wqrh2AJmNq6oj2YDnNnmeKeQe"}
# MARKETS_DEVNET={"SOL/USDC":"..."}
# MARKETS_MAINNET={"SOL/USDC":"..."}

# Signer used by scripts (setup-demo-market, seed-history)
PAYER_KEYPAIR_PATH=~/.config/solana/id.json

# seed-history budget (raw units; bigint strings)
# SEED_BASE_AMOUNT=150000000000
# SEED_QUOTE_AMOUNT=60000000000
# SEED_MAX_CYCLES=0
